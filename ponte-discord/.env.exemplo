# Copie este arquivo para ".env" (sem o ".exemplo") e preencha. NUNCA envie o .env para o GitHub nem cole no chat.

# Token do robô (Discord Developer Portal → seu aplicativo → Bot → Reset Token)
DISCORD_TOKEN=

# Quais comunidades ligar a quais canais de voz: idDaComunidade:idDoCanalDeVoz
# - idDaComunidade: o número no endereço da comunidade (comunidade.html?id=3 → 3)
# - idDoCanalDeVoz: no Discord, clique com o botão direito no canal de voz → Copiar ID do canal
# Várias pontes: separe por vírgula. Ex.: 3:123456789012345678,7:234567890123456789
PONTES=

# Supabase (Project Settings → API Keys)
SUPABASE_URL=https://jcnukczycjmktshvnnpq.supabase.co
SUPABASE_CHAVE_PUBLICA=
# Só se alguma comunidade da lista for PRIVADA (a ponte precisa ler a chave da sala). Deixe vazio se não for.
SUPABASE_SERVICE_KEY=

# Endereço do site (usado para pegar as credenciais do TURN)
SITE_URL=https://control-critic.netlify.app

# Nome que aparece na call do site
NOME_NA_CALL=🎮 Discord

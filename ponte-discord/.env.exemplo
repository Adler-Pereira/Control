# Copie este arquivo para ".env" (sem o ".exemplo") e preencha. NUNCA envie o .env para o GitHub nem cole no chat.

# Token do robô (Discord Developer Portal → seu aplicativo → Bot → Reset Token)
DISCORD_TOKEN=

# Normalmente fica VAZIO: as pontes vêm do site (o dono da comunidade configura na aba "Discord / PS5"
# e um administrador do servidor confirma com /vincular). Use só para forçar uma ponte manualmente:
# idDaComunidade:idDoCanalDeVoz (ex.: 3:123456789012345678), várias separadas por vírgula.
PONTES=

# Supabase (Project Settings → API Keys)
SUPABASE_URL=https://jcnukczycjmktshvnnpq.supabase.co
SUPABASE_CHAVE_PUBLICA=
# Secret key (obrigatória): a ponte lê a lista de pontes e as chaves das salas. Fica só no seu PC.
SUPABASE_SERVICE_KEY=

# Endereço do site (usado para pegar as credenciais do TURN)
SITE_URL=https://control-critic.netlify.app

# Nome que aparece na call do site
NOME_NA_CALL=🎮 Discord
